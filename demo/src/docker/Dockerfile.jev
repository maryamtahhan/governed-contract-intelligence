# Jev/Laya CPU pool image: a System One decision endpoint for screen:pii.
#
# The checkpoint is downloaded at BUILD time (baked into the image), so pod
# restarts need no model fetch. The default is the English checkpoint; the
# service can also serve the multilingual checkpoint, but two checkpoints
# roughly double the image. Build into the internal registry with a binary
# build, the same way as Dockerfile.specialist:
#
#   oc -n openshell-demo new-build --binary --strategy docker --name hybrid-jev
#   oc -n openshell-demo patch bc hybrid-jev --type merge \
#     -p '{"spec":{"strategy":{"dockerStrategy":{"dockerfilePath":"Dockerfile.jev"}}}}'
#   STAGE=$(mktemp -d); mkdir -p "$STAGE/src"
#   cp demo/pyproject.toml demo/src/docker/Dockerfile.jev "$STAGE/"
#   cp -R demo/src/hybrid_demo "$STAGE/src/hybrid_demo"
#   oc -n openshell-demo start-build hybrid-jev --from-dir="$STAGE" --follow
FROM python:3.12-slim

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "laya>=0.4,<0.5" \
       fastapi uvicorn httpx prometheus-client

WORKDIR /app
COPY pyproject.toml ./
COPY src/hybrid_demo ./src/hybrid_demo
RUN pip install --no-cache-dir .

# Bake the English checkpoint. HF_HOME is kept outside the app directory so
# the non-root user can read it and a read-only root filesystem still works.
ENV HF_HOME=/opt/hf-cache
RUN python -c "from hybrid_demo import pii; \
pii.jev_question_score('warmup', 'Is this text a warmup request?', model='english', question='warmup')"

RUN useradd --uid 1001 --create-home jev && chown -R 1001:0 /opt/hf-cache
USER 1001

CMD ["hybrid-jev", "--host", "0.0.0.0", "--port", "8000", "--model", "english"]
